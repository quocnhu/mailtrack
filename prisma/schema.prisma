generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum BookingStatus {
  PENDING
  ASSIGNED
}

enum AssignmentStatus {
  PENDING
  DISPATCHED
}

enum VehicleType {
  CAR
  VAN
  BUS
  LIMOUSINE
}

enum BookingProvider {
  TRIPADVISOR
  WEBSITE
  MANUAL
}

enum MailProcessStatus {
  PENDING
  PROCESSED
  FAILED
}

//////////////////////////////////////////////////////
// USERS
//////////////////////////////////////////////////////

model User {
  id String @id @default(cuid())

  email String @unique

  password String?

  fullName String

  phone String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //////////////////////////////////////////////////////
  // RBAC
  //////////////////////////////////////////////////////

  userRoles UserRole[]

  //////////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////////

  gmailAccounts GmailAccount[]

  driver Driver?

  tourGuide TourGuide?

  createdBookings Booking[] @relation("CreatedBookings")

  assignedBookings Assignment[] @relation("AssignedBy")

  auditLogs AuditLog[]
}

//////////////////////////////////////////////////////
// ROLE
//////////////////////////////////////////////////////

model Role {
  id String @id @default(cuid())

  name String @unique

  description String?

  userRoles UserRole[]

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// PERMISSION
//////////////////////////////////////////////////////

model Permission {
  id String @id @default(cuid())

  key String @unique

  description String?

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
}

//////////////////////////////////////////////////////
// USER ROLE
//////////////////////////////////////////////////////

model UserRole {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

//////////////////////////////////////////////////////
// ROLE PERMISSION
//////////////////////////////////////////////////////

model RolePermission {
  id String @id @default(cuid())

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
}

//////////////////////////////////////////////////////
// DRIVER
//////////////////////////////////////////////////////

model Driver {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  licenseNumber String?

  address String?

  emergencyPhone String?

  assignments Assignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// TOUR GUIDE
//////////////////////////////////////////////////////

model TourGuide {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  languages String[]

  experienceYears Int?

  assignments Assignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// VEHICLE
//////////////////////////////////////////////////////

model Vehicle {
  id String @id @default(cuid())

  plateNumber String @unique

  type VehicleType

  capacity Int

  brand String?

  model String?

  isActive Boolean @default(true)

  assignments Assignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// CUSTOMER
//////////////////////////////////////////////////////

model Customer {
  id String @id @default(cuid())

  fullName String

  email String?

  phone String?

  notes String?

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// BOOKING
//////////////////////////////////////////////////////

model Booking {
  id String @id @default(cuid())

  bookingCode String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  provider BookingProvider

  //////////////////////////////////////////////////////
  // NULL = created automatically from system/email
  // NOT NULL = manually created by company user
  //////////////////////////////////////////////////////

  createdById String?
  createdBy   User?   @relation("CreatedBookings", fields: [createdById], references: [id])

  //////////////////////////////////////////////////////
  // LOCATION
  //////////////////////////////////////////////////////

  pickupLocation String?

  pickupLatitude  Float?
  pickupLongitude Float?

  destination String?

  destinationLatitude  Float?
  destinationLongitude Float?

  //////////////////////////////////////////////////////
  // BOOKING DETAIL
  //////////////////////////////////////////////////////

  numberOfGuests Int?

  tour             String?
  numberOfAdults   Int?    @default(0)
  numberOfChildren Int?    @default(0)
  numberOfInfants  Int?    @default(0)
  paxes            Json?
  coordinate       String?
  payment          String?

  specialRequest String?

  tourDate DateTime?

  status BookingStatus @default(PENDING)

  //////////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////////

  assignments Assignment[]

  mailRecords MailRecord[]

  //////////////////////////////////////////////////////
  // TIMESTAMP
  //////////////////////////////////////////////////////

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //////////////////////////////////////////////////////
  // INDEX
  //////////////////////////////////////////////////////

  @@index([status])
  @@index([tourDate])
}

//////////////////////////////////////////////////////
// ASSIGNMENT
//////////////////////////////////////////////////////

model Assignment {
  id String @id @default(cuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])

  tourGuideId String?
  tourGuide   TourGuide? @relation(fields: [tourGuideId], references: [id])

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  assignedById String?
  assignedBy   User?   @relation("AssignedBy", fields: [assignedById], references: [id])

  status AssignmentStatus @default(PENDING)

  notes String?

  dispatchedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
}

//////////////////////////////////////////////////////
// GMAIL ACCOUNT & RAW DATA TABLE
//////////////////////////////////////////////////////

model GmailAccount {
  id              String       @id @default(uuid())
  email           String       @unique
  lastHistoryId   String
  watchExpiration DateTime
  refreshToken    String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User?        @relation(fields: [userId], references: [id])
  userId          String?
  mailRecords     MailRecord[]
}

model RawData {
  id        String   @id @default(uuid())
  sourceId  String   @unique
  payload   Json
  status    String // 'PENDING', 'PROCESSED', 'FAILED'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// RAW EMAIL RECORD
//////////////////////////////////////////////////////

model MailRecord {
  id String @id @default(cuid())

  gmailMessageId String @unique

  gmailThreadId String?

  historyId String?

  gmailAccountId String
  gmailAccount   GmailAccount @relation(fields: [gmailAccountId], references: [id])

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])

  provider BookingProvider

  fromEmail String?

  toEmail String?

  subject String?

  textContent String?

  htmlContent String?

  processStatus MailProcessStatus @default(PENDING)

  errorMessage String?

  receivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// AUDIT LOG
//////////////////////////////////////////////////////

model AuditLog {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  action String

  entityType String

  entityId String

  oldValue Json?

  newValue Json?

  ipAddress String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
}
