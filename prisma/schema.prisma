generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────
enum TourType {
  PRIVATE_TOUR
  GROUP_TOUR
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum BookingStatus {
  PENDING
  ASSIGNED
}

// ─── GMAIL ACCOUNT MODEL ─────────────────────────────────────────────
model GmailAccount {
  id              String       @id @default(uuid())
  email           String       @unique
  lastHistoryId   String
  watchExpiration DateTime
  refreshToken    String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

// ─── RAW DATA LANDING PAD ────────────────────────────────────────────
model RawData {
  id        String   @id @default(uuid())
  sourceId  String   @unique
  payload   Json
  status    String   // 'PENDING', 'PROCESSED', 'FAILED'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 1-to-1 link forward to the final Booking record
  booking   Booking?
}

// ─── COORDINATE CACHE ────────────────────────────────────────────────
model Coordinate {
  id        String   @id @default(uuid())
  address   String   @unique
  hotelName String?
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
}

// ─── FINAL BOOKING MODEL ─────────────────────────────────────────────
model Booking {
  id           String        @id @default(uuid())
  bookingRef   String        @unique
  provider     String
  status       BookingStatus @default(PENDING)

  // Geocoding details
  address      String?
  latitude     Float?
  longitude    Float?
  
  // Timings
  startingDate DateTime?

  // Passenger Details Extracted From Payload
  customerName String?
  phone        String?
  mail         String?       
  totalPax     Int           @default(0)
  paxDetail    Json?         // Stores object: { adults: X, children: Y, infants: Z }

  // Enums & Dynamic Names
  tourType     TourType?    
  tourName     String?       
  payment      PaymentStatus?

  // Core Audit Relation (The only remaining connection!)
  rawDataId    String        @unique
  rawData      RawData       @relation(fields: [rawDataId], references: [id])
  
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}